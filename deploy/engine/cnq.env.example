# CRYPTO NOVA engine — server-only secrets (this file is /etc/cnq.env, chmod 600). Never commit it, never paste it in chats.
# GitHub fine-grained token: Repository access → only dmytrosukhyna/cryptonova-cockpit; Permissions → Contents: Read and write.
CNQ_GH_TOKEN=
# The Telegram bot token (the same value as the GitHub secret CNQ_TG_TOKEN) — for the signal posts in «CRYPTO NOVA FUTURES».
CNQ_TG_TOKEN=
# Optional: the signals channel id. Empty = the channel the bot already knows (connected 19.10).
CNQ_SIGNALS_CHAT=
# 22.10: CRYPTO NOVA as a signal on the OKX Signal Marketplace (cnq/agents/okx_signal.py, docs/okx_signal_provider.md).
# Off unless CNQ_OKX_SIGNAL=on. The two values come from OKX: Signal bot → your custom signal → Webhook URL and signal token.
# After a change: systemctl restart cnq-engine
CNQ_OKX_SIGNAL=off
CNQ_OKX_SIGNAL_URL=
CNQ_OKX_SIGNAL_TOKEN=
