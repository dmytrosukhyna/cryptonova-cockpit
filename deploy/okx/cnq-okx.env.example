# /etc/cnq-okx.env — ONLY for the OKX autopilot service (cnq-okx-autopilot). chmod 600, owner root. Never commit it, never paste
# it in a chat. Lines are KEY=value, WITHOUT the word «export». Copy the three key values from ~/.cryptonova.env on the Mac.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_AUTOPILOT=on
# real money: only in THIS file (never in /etc/cnq.env — the engine and the API read that one)
CNQ_LIVE_TRADING=yes
# the lease (one autopilot per account) lives on the repository's branch okx-lease; `install` copies this line from /etc/cnq.env
CNQ_GH_TOKEN=
# 28.10 — read-only monitors on the server (cnq-okx-monitors.timer; `okx_autopilot_server.sh monitors`). Optional: a monitor
# without its lines is simply off. Keys with READ permission ONLY (Bybit «Read-Only», OKX «Чтение») — a key that can trade is refused.
# «Иван тест»: the Bybit API key of that account; IVAN_PASS — the same passphrase as on the Mac (the panel asks for it)
IVAN_BYBIT_KEY=
IVAN_BYBIT_SECRET=
IVAN_PASS=
# «Мой портфель · OKX»: the API key of the PERSONAL OKX account (not the sub-account); MYSPOT_PASS — the card's passphrase (12+ chars)
MYSPOT_OKX_KEY=
MYSPOT_OKX_SECRET=
MYSPOT_OKX_PASSPHRASE=
MYSPOT_PASS=
