t": 0.008446, "median_size_usd": 99.67, "status": "застывший"}, {"coin": "OP", "buy": "HTX", "sell": "Binance", "seen": 104, "fresh": 0, "first": 1792809508552, "last": 1793406411861, "share_of_samples": 0.024, "median_net": 0.002484, "max_net": 0.020789, "median_size_usd": 248.2, "status": "застывший"}, {"coin": "UNI", "buy": "OKX", "sell": "Binance", "seen": 78, "fresh": 0, "first": 1793363190376, "last": 1793406395239, "share_of_samples": 0.018, "median_net": 0.001032, "max_net": 0.001723, "median_size_usd": 566.75, "status": "застывший"}, {"coin": "SHIB", "buy": "MEXC", "sell": "HTX", "seen": 73, "fresh": 1, "first": 1792802011682, "last": 1793324126849, "share_of_samples": 0.017, "median_net": 0.001385, "max_net": 0.006501, "median_size_usd": 23.99, "status": "застывший"}, {"coin": "TRX", "buy": "Binance", "sell": "OKX", "seen": 66, "fresh": 0, "first": 1793325045885, "last": 1793402195965, "share_of_samples": 0.015, "median_net": 0.024751, "max_net": 0.037952, "median_size_usd": 41.05, "status": "застывший"}, {"coin": "OP", "buy": "HTX", "sell": "KuCoin", "seen": 59, "fresh": 0, "first": 1792835060350, "last": 1793386412231, "share_of_samples": 0.014, "median_net": 0.004273, "max_net": 0.009511, "median_size_usd": 248.04, "status": "застывший"}], "by_venue": {"HTX": 1022, "Binance": 889, "MEXC": 731, "OKX": 409, "KuCoin": 291, "Bitget": 78, "Gate": 46}, "rules": "окно = ≥0.05% после комиссий обеих бирж; виртуально до $1,000 на окно, но не больше, чем стоит в лучшей цене стакана; монета, которая на той же бирже уже давала окно за последние сутки, считается застывшей; разница >5% не считается (другой токен/закрыт вывод)", "note": "Сервер смотрит цены 3 раза за запуск (раз в 10–30 минут) — это выборка, а не непрерывное наблюдение. Окно, которое держится часами, почти всегда «застывшее»: на бирже закрыт ввод/вывод монеты или стакан пустой — такое считаем один раз в сутки. Оценка оптимистичная: деньги заранее на обеих биржах, исполнение по лучшей цене без задержки, перевод не нужен.", "explain_ru": "Это виртуальный счёт, не деньги. Сервер раз в 10–30 минут трижды смотрит цены 7 бирж (Bybit серверу недоступны) и «засчитывает» сделку, если монета на одной бирже дешевле, чем на другой, больше чем на 0.05% после комиссий. За сутки 381 проверок, окно было в 100% из них, но 1718 из 1733 наблюдений — застывшие: та же монета на той же бирже держит разницу часами. Главные: TRX Binance→KuCoin до 4.67%, TRX Binance→HTX до 4.55%, TRX Binance→OKX до 3.80%. Так бывает, когда на бирже закрыт ввод/вывод монеты или стакан пустой — забрать такую разницу нельзя. Чаще всего в окнах участвует HTX (1022 из 1733 наблюдений). Новых окон за сутки 15, обычно 0.09% чистыми, в лучшей цене стакана в среднем $33. Честная оценка — +$7.16 за сутки (старый подсчёт по маршрутам по $1 000 дал бы $155.87). Из 251 эпизодов 170 исчезли в пределах одного запуска, 81 дожили до следующего, 12 держались час и дольше. Чтобы зарабатывать на этом вживую, нужны деньги заранее на обеих биржах (USDT там, где покупаем, монета там, где продаём), периодический перевод для выравнивания (≈ $1–2 и от минут до часа) и робот, который смотрит цены каждую секунду, а не раз в полчаса."}