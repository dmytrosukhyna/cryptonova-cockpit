t": 0.047858, "median_size_usd": 72.06, "status": "застывший"}, {"coin": "LTC", "buy": "MEXC", "sell": "HTX", "seen": 141, "fresh": 2, "first": 1793082751967, "last": 1793374111508, "share_of_samples": 0.036, "median_net": 0.003263, "max_net": 0.024278, "median_size_usd": 7.17, "status": "застывший"}, {"coin": "UNI", "buy": "OKX", "sell": "Binance", "seen": 138, "fresh": 0, "first": 1793363190376, "last": 1793478498022, "share_of_samples": 0.035, "median_net": 0.001162, "max_net": 0.002219, "median_size_usd": 578.59, "status": "застывший"}, {"coin": "ARB", "buy": "HTX", "sell": "MEXC", "seen": 135, "fresh": 1, "first": 1793270712624, "last": 1793466693285, "share_of_samples": 0.034, "median_net": 0.001441, "max_net": 0.008446, "median_size_usd": 99.6, "status": "застывший"}, {"coin": "TRX", "buy": "Binance", "sell": "OKX", "seen": 101, "fresh": 0, "first": 1793325045885, "last": 1793459456979, "share_of_samples": 0.026, "median_net": 0.023923, "max_net": 0.038706, "median_size_usd": 40.39, "status": "застывший"}, {"coin": "BCH", "buy": "MEXC", "sell": "HTX", "seen": 82, "fresh": 1, "first": 1793359143169, "last": 1793481232843, "share_of_samples": 0.021, "median_net": 0.001615, "max_net": 0.005649, "median_size_usd": 11.42, "status": "застывший"}], "by_venue": {"Binance": 1160, "HTX": 935, "MEXC": 787, "OKX": 350, "KuCoin": 317, "Bitget": 34, "Bybit": 6, "Gate": 5}, "rules": "окно = ≥0.05% после комиссий обеих бирж; виртуально до $1,000 на окно, но не больше, чем стоит в лучшей цене стакана; монета, которая на той же бирже уже давала окно за последние сутки, считается застывшей; разница >5% не считается (другой токен/закрыт вывод)", "note": "Сервер смотрит цены 3 раза за запуск (раз в 10–30 минут) — это выборка, а не непрерывное наблюдение. Окно, которое держится часами, почти всегда «застывшее»: на бирже закрыт ввод/вывод монеты или стакан пустой — такое считаем один раз в сутки. Оценка оптимистичная: деньги заранее на обеих биржах, исполнение по лучшей цене без задержки, перевод не нужен.", "explain_ru": "Это виртуальный счёт, не деньги. Сервер раз в 10–30 минут трижды смотрит цены 7 бирж (Bybit серверу недоступны) и «засчитывает» сделку, если монета на одной бирже дешевле, чем на другой, больше чем на 0.05% после комиссий. За сутки 327 проверок, окно было в 100% из них, но 1794 из 1797 наблюдений — застывшие: та же монета на той же бирже держит разницу часами. Главные: TRX Binance→KuCoin до 4.71%, TRX Binance→OKX до 3.87%, TRX Binance→HTX до 3.80%. Так бывает, когда на бирже закрыт ввод/вывод монеты или стакан пустой — забрать такую разницу нельзя. Чаще всего в окнах участвует Binance (1160 из 1797 наблюдений). Новых окон за сутки 3, обычно 0.11% чистыми, в лучшей цене стакана в среднем $81. Честная оценка — +$3.05 за сутки (старый подсчёт по маршрутам по $1 000 дал бы $120.23). Из 128 эпизодов 76 исчезли в пределах одного запуска, 52 дожили до следующего, 15 держались час и дольше. Чтобы зарабатывать на этом вживую, нужны деньги заранее на обеих биржах (USDT там, где покупаем, монета там, где продаём), периодический перевод для выравнивания (≈ $1–2 и от минут до часа) и робот, который смотрит цены каждую секунду, а не раз в полчаса."}